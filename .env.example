# ── Admin login ─────────────────────────────────────────────
# The password you type into the Admin panel on the site.
ADMIN_PASSWORD=AhmadRaza@2025

# Random string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# ── Persistent storage (pick ONE method) ───────────────────
# Method A — Vercel dashboard (easiest): Project → Storage tab →
# Create Database → Redis. Vercel injects KV_REST_API_URL /
# KV_REST_API_TOKEN automatically — you don't need to set these by hand.
#
# Method B — Upstash.com directly: create a free Redis database at
# https://console.upstash.com, copy the REST URL + token below.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
